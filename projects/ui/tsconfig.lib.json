/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/lib",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "types": []
  },
  "include": ["**/*.ts"],
  "exclude": [
    "docs",
    "styles",
    "src/test-setup.ts",
    "**/*.spec.ts",
    "**/*.spec-helper.ts",
    "**/*.stories.ts",
    "**/*-story-fixtures.ts"
  ]
}
